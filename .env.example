# kwtSMS Ecwid Plugin - Environment Variables
# Copy this file to .env and fill in the values

# =============================================================================
# kwtSMS Gateway Credentials
# =============================================================================
# Your kwtSMS API username (not your mobile number)
KWTSMS_USERNAME=
# Your kwtSMS API password
KWTSMS_PASSWORD=
# Default SenderID (fetched dynamically from API after login)
KWTSMS_SENDER_ID=KWT-SMS
# Test mode: 1 = test (no delivery), 0 = production
KWTSMS_TEST_MODE=1

# =============================================================================
# Ecwid App Credentials
# =============================================================================
# Your Ecwid app client_id (assigned when you register the app)
ECWID_CLIENT_ID=
# Your Ecwid app client_secret
ECWID_CLIENT_SECRET=
# Your Ecwid store ID (for single-store mode / development)
ECWID_STORE_ID=

# =============================================================================
# Application Settings
# =============================================================================
# Secret key for encrypting stored credentials (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
APP_SECRET_KEY=
# Application host and port
APP_HOST=0.0.0.0
APP_PORT=8000
# Base URL (used for webhook registration, set to ngrok URL for local dev)
APP_BASE_URL=http://localhost:8000
# Debug mode (enables verbose logging)
APP_DEBUG=true
# Default language (en or ar)
APP_DEFAULT_LANG=en

# =============================================================================
# Database
# =============================================================================
# SQLite database path (relative to app root)
DATABASE_PATH=data/kwtsms_ecwid.db
