# kwtSMS Ecwid Plugin - Environment Variables
# Copy this file to .env and fill in your values.

# === App Settings ===
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-random-64-char-string
APP_HOST=0.0.0.0
APP_PORT=8000
APP_BASE_URL=https://your-domain.com

# === Ecwid Settings ===
ECWID_APP_ID=your-ecwid-app-id
ECWID_CLIENT_SECRET=your-ecwid-client-secret

# === kwtSMS API ===
# Credentials are stored encrypted in the database per store.
# These are only used as fallback/defaults for single-store mode.
KWTSMS_DEFAULT_USERNAME=
KWTSMS_DEFAULT_PASSWORD=
KWTSMS_API_BASE_URL=https://www.kwtsms.com/API

# === Encryption ===
ENCRYPTION_KEY=generate-with-cryptography-fernet-key

# === Database ===
DATABASE_PATH=./data/kwtsms_ecwid.db

# === Scheduler ===
SYNC_HOUR=3
SYNC_MINUTE=0
